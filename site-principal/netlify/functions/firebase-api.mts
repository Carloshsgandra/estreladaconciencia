async function updateConfig(user: any, input: any) { if (user.role !== 'admin') fail('Acesso administrativo necessário.', 403); const { db } = user, ref = db.doc('configuracoes/main'); await db.runTransaction(async (tx: any) => { const current = await tx.get(ref), version = Number(current.data()?.versao || 0), data = input.dados; if (version !== Number(input.versaoAtual)) fail('A configuração foi alterada em outra aba.', 409); if (!data || !Array.isArray(data.servicos) || !Array.isArray(data.agenda?.semana)) fail('Configuração inválida.'); tx.set(ref, { ...data, versao: version + 1, atualizadoEm: FieldValue.serverTimestamp() }); audit(tx, db, user.uid, 'editar_configuracao', 'main'); }); return { ok: true }; }
