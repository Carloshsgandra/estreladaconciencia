async function cancelBooking(user: any, input: any) { const { db } = user, id = text(input.id, 120, true), ref = db.doc(`agendamentos/${id}`); await db.runTransaction(async (tx: any) => { const current = await tx.get(ref); if (!current.exists) fail('Agendamento não encontrado.', 404); const booking = current.data(); if (booking.clienteUid !== user.uid && user.role !== 'admin') fail('Você não pode cancelar este agendamento.', 403); if (!active.has(booking.status)) fail('Este agendamento não pode mais ser cancelado.', 409); const bookedSlots = await tx.get(db.collection('agendaSlots').where('agendamentoId', '==', id)); bookedSlots.docs.forEach((slot: any) => tx.delete(slot.ref)); tx.update(ref, { status: 'cancelado', versao: Number(booking.versao || 0) + 1, atualizadoEm: FieldValue.serverTimestamp() }); audit(tx, db, user.uid, 'cancelar_agendamento', id); }); return { id }; }
async function updateBooking(user: any, input: any) { if (user.role !== 'admin') fail('Acesso administrativo necessário.', 403); const { db } = user, id = text(input.id, 120, true), ref = db.doc(`agendamentos/${id}`); await db.runTransaction(async (tx: any) => { const current = await tx.get(ref); if (!current.exists) fail('Agendamento não encontrado.', 404); const booking = current.data(), status = text(input.status || booking.status, 20, true); if (Number(input.versaoAtual) !== Number(booking.versao)) fail('Este agendamento foi alterado em outra aba.', 409); if (!statuses.has(status) || (status === 'concluido' && booking.fimEm.toDate().getTime() > Date.now())) fail('Status inválido para este agendamento.', 409); let changes: any = { status, observacoesInternas: text(input.observacoesInternas || '', 5000), cartas: text(input.cartas || '', 300), linkVideo: text(input.linkVideo || '', 2048), local: text(input.local || '', 400), versao: Number(booking.versao) + 1, atualizadoEm: FieldValue.serverTimestamp() }; if (input.data || input.horario) { const config = (await tx.get(db.doc('configuracoes/main'))).data(), day = date(input.data || booking.data), at = hour(input.horario || booking.horario), start = availability(config, day, at, Number(booking.duracaoMinutos)), end = new Date(start.getTime() + Number(booking.duracaoMinutos) * 60_000), ids = slots(day, start, end), refs = ids.map(slot => db.doc(`agendaSlots/${slot}`)), occupied = await tx.getAll(...refs); if (occupied.some((slot: any) => slot.exists && slot.data()?.agendamentoId !== id)) fail('O novo horário foi ocupado.', 409); const oldSlots = await tx.get(db.collection('agendaSlots').where('agendamentoId', '==', id)); oldSlots.docs.forEach((slot: any) => tx.delete(slot.ref)); refs.forEach((slot: any, index: number) => tx.set(slot, { data: day, horario: ids[index].slice(-5).replace('-', ':'), agendamentoId: id, clienteUid: booking.clienteUid, status: 'reservado', criadoEm: FieldValue.serverTimestamp() })); changes =